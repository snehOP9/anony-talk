# Local AnonyTalk API configuration
PORT=5001

# Optional AI chat integration
GEMINI_API_KEY=

# Express JSON parser limit. Keep this finite in public deployments.
JSON_BODY_LIMIT=32kb

# Trusted browser origins (comma-separated); same-origin calls work without CORS.
# Production defaults to no cross-origin access when unset.
CORS_ORIGINS=http://localhost:5173
