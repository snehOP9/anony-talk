# Local AnonyTalk API configuration
PORT=5001

# Optional AI chat integration
GEMINI_API_KEY=

# Express JSON parser limit. Keep this finite in public deployments.
JSON_BODY_LIMIT=32kb

# Exact comma-separated browser origins allowed to call this API.
# In production, set this to the deployed frontend origin(s); never use '*'.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
